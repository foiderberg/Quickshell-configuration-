

import QtQuick
import QtQuick.Controls
import Quickshell
import Quickshell.Hyprland
import Quickshell.Networking
import Quickshell.Bluetooth
import Quickshell.Services.Pipewire
import Quickshell.Services.SystemTray
import Quickshell.Io

PanelWindow {
    id: root

    Theme { id: theme }

    anchors {
        top: true
        left: true
        right: true
    }

    implicitHeight: 64
    exclusiveZone: 64
    color: "transparent"

    property bool triggerHovered: false
    property bool panelHovered: false
    property bool menuVisible: false

    function deviceConnected(deviceName) {
        for (let i = 0; i < Networking.devices.count; i++) {
            let device = Networking.devices.get(i)
            if (device.name === deviceName)
                return device.connected
        }
        return false
    }

    function scheduleClose() {
        closeTimer.restart()
    }

    Timer {
        id: closeTimer
        interval: 250
        repeat: false

        onTriggered: {
            if (!root.triggerHovered && !root.panelHovered)
                root.menuVisible = false
        }
    }

    PwObjectTracker {
        objects: [Pipewire.defaultAudioSink]
    }

    Rectangle {
        anchors.fill: parent
        anchors.margins: 8
        radius: 14
        color: theme.barBackground
        border.color: theme.border
        border.width: 1

        // LEFT: WORKSPACES
        Row {
            anchors.left: parent.left
            anchors.leftMargin: 14
            anchors.verticalCenter: parent.verticalCenter
            spacing: 7

            Repeater {
                model: Hyprland.workspaces

                delegate: Rectangle {
                    required property var modelData

                    visible: modelData.id > 0 && modelData.id <= 10
                    width: 30
                    height: 30
                    radius: 9

                    color: Hyprland.focusedWorkspace?.id === modelData.id
                        ? theme.accent : theme.surfaceAlt

                    Text {
                        anchors.centerIn: parent
                        text: modelData.id
                        color: Hyprland.focusedWorkspace?.id === modelData.id
                            ? theme.accentText : theme.muted
                        font.pixelSize: 13
                        font.bold: true
                    }

                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: Hyprland.dispatch(
                            "workspace " + modelData.id
                        )
                    }
                }
            }
        }

        // CENTER: CLOCK
        Text {
            id: clockText
            anchors.centerIn: parent
            text: Qt.formatDateTime(new Date(), "ddd  dd MMM  •  hh:mm")
            color: theme.text
            font.pixelSize: 13
            font.bold: true

            Timer {
                interval: 1000
                running: true
                repeat: true
                onTriggered: clockText.text =
                    Qt.formatDateTime(new Date(), "ddd  dd MMM  •  hh:mm")
            }
        }

        // RIGHT: ETHERNET, TRAY, CONTROL CENTRE
        Row {
            anchors.right: parent.right
            anchors.rightMargin: 14
            anchors.verticalCenter: parent.verticalCenter
            spacing: 12

            Text {
                text: root.deviceConnected("enp8s0")
                    ? "ETH" : "OFFLINE"
                color: theme.textSoft
                font.pixelSize: 11
                font.bold: true
            }

            // SYSTEM TRAY
            Row {
                spacing: 8

                Repeater {
                    model: SystemTray.items

                    delegate: Item {
                        required property var modelData
                        width: 18
                        height: 18

                        Image {
                            anchors.fill: parent
                            source: modelData.icon
                            fillMode: Image.PreserveAspectFit
                            smooth: true
                        }

                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: modelData.activate()
                            onPressAndHold: {
                                if (modelData.hasMenu)
                                    modelData.display(root, 0, 64)
                            }
                        }
                    }
                }
            }

            // CONTROL CENTRE TRIGGER
            Rectangle {
                width: 34
                height: 34
                radius: 10
                color: triggerHover.hovered
                    ? theme.borderStrong : theme.surfaceAlt
                border.color: theme.borderStrong
                border.width: 1

                Text {
                    anchors.centerIn: parent
                    text: "☷"
                    color: theme.text
                    font.pixelSize: 21
                }

                HoverHandler {
                    id: triggerHover

                    onHoveredChanged: {
                        root.triggerHovered = hovered

                        if (hovered) {
                            closeTimer.stop()
                            root.menuVisible = true
                        } else {
                            root.scheduleClose()
                        }
                    }
                }
            }
        }
    }

    // FLOATING CONTROL CENTRE
    PopupWindow {
        id: controlCentre

        anchor.window: root
        anchor.rect.x: root.width - width - 8
        anchor.rect.y: 64

        width: 310
        height: 520
        visible: root.menuVisible

        color: "transparent"

        Rectangle {
            anchors.fill: parent
            radius: 18
            color: theme.panelBackground
            border.color: theme.borderStrong
            border.width: 1

            HoverHandler {
                id: panelHover

                onHoveredChanged: {
                    root.panelHovered = hovered

                    if (hovered)
                        closeTimer.stop()
                    else
                        root.scheduleClose()
                }
            }

            Column {
                anchors.fill: parent
                anchors.margins: 18
                spacing: 15

                // HEADER
                Row {
                    width: parent.width

                    Text {
                        text: "CONTROL CENTRE"
                        color: theme.text
                        font.pixelSize: 14
                        font.bold: true
                    }

                    Item {
                        width: 1
                        height: 1
                    }
                }

                Rectangle {
                    width: parent.width
                    height: 1
                    color: theme.border
                }

                // NETWORK
                Text {
                    text: "NETWORK"
                    color: theme.subdued
                    font.pixelSize: 10
                    font.bold: true
                }

                Rectangle {
                    width: parent.width
                    height: 58
                    radius: 11
                    color: theme.surface
                    border.color: theme.border

                    Row {
                        anchors.fill: parent
                        anchors.margins: 12
                        spacing: 10

                        Column {
                            width: 165
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 4

                            Text {
                                text: "Ethernet"
                                color: theme.text
                                font.pixelSize: 13
                                font.bold: true
                            }

                            Text {
                                text: root.deviceConnected("enp8s0")
                                    ? "Connected" : "Disconnected"
                                color: theme.muted
                                font.pixelSize: 11
                            }
                        }

                        Item {
                            width: 1
                            height: 1
                        }

                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: "●"
                            color: root.deviceConnected("enp8s0")
                                ? theme.accent : theme.inactive
                            font.pixelSize: 13
                        }
                    }
                }

                Rectangle {
                    width: parent.width
                    height: 58
                    radius: 11
                    color: theme.surface
                    border.color: theme.border

                    Row {
                        anchors.fill: parent
                        anchors.margins: 12

                        Column {
                            width: 190
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 4

                            Text {
                                text: "Wi-Fi"
                                color: theme.text
                                font.pixelSize: 13
                                font.bold: true
                            }

                            Text {
                                text: Networking.wifiEnabled
                                    ? "Enabled" : "Disabled"
                                color: theme.muted
                                font.pixelSize: 11
                            }
                        }

                        Rectangle {
                            width: 42
                            height: 23
                            radius: 12
                            anchors.verticalCenter: parent.verticalCenter
                            color: Networking.wifiEnabled
                                ? theme.accent : theme.inactive

                            Rectangle {
                                width: 17
                                height: 17
                                radius: 9
                                y: 3
                                x: Networking.wifiEnabled ? 22 : 3
                                color: theme.accentText

                                Behavior on x {
                                    NumberAnimation { duration: 140 }
                                }
                            }

                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: Networking.wifiEnabled =
                                    !Networking.wifiEnabled
                            }
                        }
                    }
                }

                // BLUETOOTH
                Text {
                    text: "BLUETOOTH"
                    color: theme.subdued
                    font.pixelSize: 10
                    font.bold: true
                }

                Rectangle {
                    width: parent.width
                    height: 58
                    radius: 11
                    color: theme.surface
                    border.color: theme.border

                    Row {
                        anchors.fill: parent
                        anchors.margins: 12

                        Column {
                            width: 190
                            anchors.verticalCenter: parent.verticalCenter
                            spacing: 4

                            Text {
                                text: "Bluetooth"
                                color: theme.text
                                font.pixelSize: 13
                                font.bold: true
                            }

                            Text {
                                text: Bluetooth.defaultAdapter?.enabled
                                    ? "On" : "Off"
                                color: theme.muted
                                font.pixelSize: 11
                            }
                        }

                        Rectangle {
                            width: 42
                            height: 23
                            radius: 12
                            anchors.verticalCenter: parent.verticalCenter
                            color: Bluetooth.defaultAdapter?.enabled
                                ? theme.accent : theme.inactive

                            Rectangle {
                                width: 17
                                height: 17
                                radius: 9
                                y: 3
                                x: Bluetooth.defaultAdapter?.enabled
                                    ? 22 : 3
                                color: theme.accentText

                                Behavior on x {
                                    NumberAnimation { duration: 140 }
                                }
                            }

                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    if (Bluetooth.defaultAdapter)
                                        Bluetooth.defaultAdapter.enabled =
                                            !Bluetooth.defaultAdapter.enabled
                                }
                            }
                        }
                    }
                }

                // SOUND
                Text {
                    text: "SOUND"
                    color: theme.subdued
                    font.pixelSize: 10
                    font.bold: true
                }

                Row {
                    width: parent.width
                    spacing: 10

                    Text {
                        width: 48
                        anchors.verticalCenter: parent.verticalCenter
                        text: Pipewire.defaultAudioSink?.audio?.muted
                            ? "MUTED"
                            : Math.round(
                                (Pipewire.defaultAudioSink?.audio?.volume ?? 0) * 100
                              ) + "%"
                        color: theme.textSoft
                        font.pixelSize: 11
                    }

                    Slider {
                        id: volumeSlider
                        width: 195
                        from: 0
                        to: 1
                        anchors.verticalCenter: parent.verticalCenter

                        value: Pipewire.defaultAudioSink?.audio?.volume ?? 0

                        onMoved: {
                            let audio = Pipewire.defaultAudioSink?.audio
                            if (audio)
                                audio.volume = value
                        }
                    }
                }

                Rectangle {
                    width: parent.width
                    height: 1
                    color: theme.border
                }

                // POWER
                Text {
                    text: "POWER"
                    color: theme.subdued
                    font.pixelSize: 10
                    font.bold: true
                }

                Row {
                    width: parent.width
                    spacing: 7

                    Repeater {
                        model: [
                            { label: "LOCK", command: "lock" },
                            { label: "SUSPEND", command: "suspend" },
                            { label: "LOGOUT", command: "logout" },
                            { label: "REBOOT", command: "reboot" },
                            { label: "OFF", command: "poweroff" }
                        ]

                        delegate: Rectangle {
                            required property var modelData

                            width: 48
                            height: 36
                            radius: 8
                            color: powerHover.hovered
                                ? theme.surfaceHover : theme.surfaceAlt
                            border.color: theme.inactive

                            Text {
                                anchors.centerIn: parent
                                text: modelData.label
                                color: theme.textSoft
                                font.pixelSize: 8
                                font.bold: true
                            }

                            HoverHandler {
                                id: powerHover
                            }

                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor

                                onClicked: {
                                    if (modelData.command === "lock")
                                        Quickshell.execDetached(
                                            ["loginctl", "lock-session"]
                                        )
                                    else if (modelData.command === "suspend")
                                        Quickshell.execDetached(
                                            ["systemctl", "suspend"]
                                        )
                                    else if (modelData.command === "logout")
                                        Quickshell.execDetached(
                                            ["hyprctl", "dispatch", "exit"]
                                        )
                                    else if (modelData.command === "reboot")
                                        Quickshell.execDetached(
                                            ["systemctl", "reboot"]
                                        )
                                    else if (modelData.command === "poweroff")
                                        Quickshell.execDetached(
                                            ["systemctl", "poweroff"]
                                        )
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
